#? Backend Configuration
NODE_ENV=development

#? NATS (must match Api-Gateway and ATS – required for health and all HRMS endpoints)
NATS_URL=nats://localhost:4222

#? Database (MongoDB)
MONGO_URI_LOCAL=mongodb://localhost:27017
MONGO_URI_REMOTE=
MONGO_DB_NAME=hrms

#? JWT
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

#? Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

#? Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=
# FRONTEND_ORIGIN=

#? AWS S3 (optional)
# AWS_S3_REGION=
# AWS_S3_ACCESS_KEY_ID=
# AWS_S3_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
