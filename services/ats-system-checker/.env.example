#? Backend Configuration
NODE_ENV=development

#? NATS (must match Api-Gateway and HRMS – required for health and all ATS endpoints)
NATS_URL=nats://localhost:4222

#? Database (MongoDB)
MONGO_URI_LOCAL=mongodb://localhost:27017
MONGO_URI_REMOTE=
MONGO_DB_NAME=ats

#? JWT
JWT_ACCESS_SECRET=your-rsa-256-bit-private-key-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-rsa-256-bit-private-key-here
JWT_REFRESH_EXPIRES_IN=7d

#? Security Configuration
INTERNAL_SERVICE_SECRET=your-64-character-secret-key-minimum-length
ENCRYPTION_SECRET=64-character-minimum-secret-for-field-encryption

#? NATS Security (for TLS and authentication)
NATS_AUTH_TOKEN=your-secure-nats-auth-token
NATS_TLS_CA_FILE=/path/to/ca.crt
NATS_TLS_CERT_FILE=/path/to/client.crt
NATS_TLS_KEY_FILE=/path/to/client.key

#? Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

#? AWS S3 Configuration
AWS_S3_REGION=eu-north-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=
AWS_S3_BUCKET_URL=
UPLOADS_BASE_URL=
