{
    "compilerOptions": {
      "target": "es2017",
      "module": "commonjs",
      "outDir": "dist",
      "baseUrl": ".",
      "paths": {
        "server/*": ["../server/src/*"] 
      },
      "rootDirs": [".", "../server/src"], 
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules"]
  }
  