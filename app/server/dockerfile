# Use a specific Node.js Alpine version for stability
FROM node:20-alpine

# Set working directory
WORKDIR /app

# Copy package files first for layer caching
COPY package*.json ./

# Install all dependencies (including devDependencies for build)
RUN npm install

# Copy the rest of the app
COPY tsconfig.json ./
COPY src ./src

# Build the TypeScript project
RUN npm run build

# Copy tsconfig.json into dist for runtime path resolution
RUN cp tsconfig.json ./dist/

# Prune devDependencies after build to reduce image size
RUN npm prune --production

# Set working directory to the compiled output
WORKDIR /app/dist

# Expose the port
EXPOSE 8000

# Start the application
CMD ["node", "-r", "tsconfig-paths/register", "index.js"]
